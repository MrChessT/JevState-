# --- Portal -------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# El portal no se indexa hasta que haya contenido real (fase 2).
NEXT_PUBLIC_INDEXABLE=false
# Entorno con los 300 inmuebles ficticios de desarrollo: se avisa en el pie.
NEXT_PUBLIC_DATOS_FICTICIOS=true

# --- Supabase (local: npm run db:start) -------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo trabajos en segundo plano (ingesta, enriquecimiento). Nunca en el cliente.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Jev (TypeSafe) ---------------------------------------------------------------------------
# Sin clave se usa el Jev simulado (FakeJev). En Vercel, sin claves, se usa AI Gateway con OIDC.
# TYPESAFE_API_KEY=
# JEV_BASE_URL=https://api.typesafe.ai
# JEV_MODEL=jev-latest
# Alternativa: Vercel AI Gateway (modelo typesafe-ai/jev)
# AI_GATEWAY_API_KEY=
# JEV_TIMEOUT_MS=4000
# JEV_MAX_RETRIES=1
# JEV_FAKE=true

# --- Umbrales (opcional; por defecto los de src/gates/thresholds.ts) -------------------------
# GATE_ZONA_ACT=0.7
# GATE_ZONA_ASK=0.45
# GATE_ZONA_MARGIN=0.2

# --- Plano de control (solo npm run catalog:compile) -------------------------------------------
# CATALOG_SHEET_ID=
# CATALOG_SHEET_API_KEY=

# --- Operación ------------------------------------------------------------------------------
# Token para /api/salud con comprobación de Jev y métricas (mínimo 16 caracteres).
# METRICS_TOKEN=
# ANON_CONVERSATION_RETENTION_DAYS=30
