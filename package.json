{
  "name": "plataforma-inmobiliaria",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test && npm run eval && npm run build",
    "catalog:compile": "tsx scripts/catalog-compile.ts",
    "catalog:docs": "tsx scripts/catalog-docs.ts",
    "eval": "tsx eval/run.ts",
    "eval:jev": "tsx --env-file-if-exists=.env.local eval/run.ts --jev",
    "eval:sweep": "tsx --env-file-if-exists=.env.local eval/sweep.ts",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:test:local": "bash scripts/db-test-local.sh",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.0",
    "@typesafe-ai/sdk": "0.6.0",
    "@vercel/oidc": "^3.8.9",
    "decimal.js": "10.6.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
